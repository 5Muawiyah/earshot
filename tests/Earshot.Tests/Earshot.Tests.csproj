<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFramework and SupportedOSPlatformVersion come from Directory.Build.props, the one place they are
         written. A copy here fell out of step the moment the application's moniker gained a Windows version:
         a net10.0-windows test project cannot reference a net10.0-windows10.0.19041.0 application (NU1201). -->
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Earshot\Earshot.csproj" />
    <ProjectReference Include="..\..\src\Earshot.TestWindow\Earshot.TestWindow.csproj" />
  </ItemGroup>
</Project>

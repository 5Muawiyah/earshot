<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFramework and SupportedOSPlatformVersion come from Directory.Build.props, the one
         place they are written (see NoSuppressionsTests.TheFloorIsSetInDirectoryBuildPropsAndNowhereElse). -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Earshot.TestWindow</AssemblyName>
    <RootNamespace>Earshot.TestWindow</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- A development tool, never part of the release. tools\build-release.ps1 publishes
         src\Earshot\Earshot.csproj by path, so this alone keeps it out of the zip; the flag also
         means a plain "dotnet publish" on the solution cannot put it there by accident. -->
    <IsPublishable>false</IsPublishable>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Earshot.Tests" />
  </ItemGroup>
  <!-- The manifest travels beside the exe: Manifest.cs reads it from AppContext.BaseDirectory,
       the same folder Program.cs walks up from to find Earshot.slnx. -->
  <ItemGroup>
    <None Include="Data\tests.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\wording.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Drawn, not captured (see HowToPictureGenerator's own comment): PromptPresenter loads
         these by name, and a missing file shows nothing rather than an error on screen
         (HowToPictureCoverageTests lists any that are missing). -->
    <None Include="Data\pictures\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\pictures\README.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

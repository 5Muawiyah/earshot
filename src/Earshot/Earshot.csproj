<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Earshot</AssemblyName>
    <RootNamespace>Earshot</RootNamespace>
    <!-- The one place the release version is written. tools\build-release.ps1 reads Version from here,
         names the zip after it, and checks the published Earshot.exe reports the same. -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <!-- Written into the file's LegalCopyright, so the one thing a user can right-click says who owns it
         and under what licence. It matches LICENSE. -->
    <Copyright>Copyright (c) 2026 5Muawiyah. MIT licence.</Copyright>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>            <!-- [LibraryImport] needs it (SYSLIB1062) -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <StartupHookSupport>false</StartupHookSupport>        <!-- writes IsSupported=false to runtimeconfig;
                                                                closes DOTNET_STARTUP_HOOKS in the gate -->
    <!-- SelfContained + RuntimeIdentifier are intentionally NOT set here.
         Setting them makes tests\Earshot.Tests fail to reference this exe (NETSDK1151).
         They are supplied on the dotnet publish command line only. -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Earshot.Tests" />
  </ItemGroup>
  <!-- v1.1 voiceover: when it was chosen, the only first-party managed way to speak offline without moving
       the app to a Windows-version-specific TargetFramework (net10.0-windows10.0.19041.0, for the WinRT
       synthesiser). Audio streaming has since moved the app to that TargetFramework (Directory.Build.props);
       the speech engine was not revisited then, and this package is still what speaks.
       Microsoft-published, MIT licensed, pinned to the 10.0.* band matching the installed SDK
       (global.json: 10.0.401). Used only from src\Earshot\Voice\SystemSpeechEngine.cs. -->
  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>
  <!-- Writes Earshot.files.json beside the published files: the path (relative, with "/" separators) and the
       SHA-256 of every file this publish wrote, except the manifest itself. The list is @(ResolvedFileToPublish)
       at its RelativePath, the items the SDK's publish copies, not whatever the folder holds. The folder must hold
       exactly those files: one left there by an earlier publish, or a listed file that is missing, stops the
       publish with no manifest, so a leftover is never listed and install never copies one into the install
       folder. install copies only what this lists and checks each copy against these hashes. Hashes come from the
       built-in GetFileHash task.
       https://learn.microsoft.com/en-us/visualstudio/msbuild/getfilehash-task
       https://learn.microsoft.com/en-us/visualstudio/msbuild/writelinestofile-task
       https://learn.microsoft.com/en-us/visualstudio/msbuild/msbuild-transforms -->
  <Target Name="WriteEarshotFileManifest" AfterTargets="Publish">
    <PropertyGroup>
      <EarshotPublishRoot>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</EarshotPublishRoot>
      <EarshotManifestPath>$(EarshotPublishRoot)Earshot.files.json</EarshotManifestPath>
    </PropertyGroup>
    <!-- A manifest from an earlier publish never survives a publish that stops below. -->
    <Delete Files="$(EarshotManifestPath)" />
    <ItemGroup>
      <EarshotResolvedFile Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.CopyToPublishDirectory)' != 'Never'" />
      <EarshotListedFile Include="@(EarshotResolvedFile->'$(EarshotPublishRoot)%(RelativePath)')" />
      <!-- The manifest records "/" whatever the build ran on, so the reader never meets an escaped backslash. The
           path is kept as metadata because GetFileHash hands back copies that keep custom metadata only. -->
      <EarshotListedFile>
        <ManifestPath>$([System.String]::Copy('%(RelativePath)').Replace('\', '/'))</ManifestPath>
      </EarshotListedFile>
    </ItemGroup>
    <RemoveDuplicates Inputs="@(EarshotListedFile)">
      <Output TaskParameter="Filtered" ItemName="EarshotPublishedFile" />
    </RemoveDuplicates>
    <ItemGroup>
      <EarshotFolderFile Include="$(EarshotPublishRoot)**\*" Exclude="$(EarshotManifestPath)" />
      <EarshotUnlistedFile Include="@(EarshotFolderFile)" Exclude="@(EarshotPublishedFile)" />
      <EarshotMissingFile Include="@(EarshotPublishedFile)" Exclude="@(EarshotFolderFile)" />
    </ItemGroup>
    <Error Condition="'@(EarshotUnlistedFile)' != ''" Text="$(EarshotPublishRoot) holds files this publish did not write, so no file manifest was written: @(EarshotUnlistedFile->'%(FullPath)', ', '). Publish into an empty folder." />
    <Error Condition="'@(EarshotMissingFile)' != ''" Text="Files this publish lists are not in $(EarshotPublishRoot), so no file manifest was written: @(EarshotMissingFile->'%(FullPath)', ', ')." />
    <GetFileHash Files="@(EarshotPublishedFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="EarshotHashedFile" />
    </GetFileHash>
    <PropertyGroup>
      <EarshotManifestEntries>@(EarshotHashedFile->'    { "Path": "%(ManifestPath)", "Sha256": "%(FileHash)" }', ',%0D%0A')</EarshotManifestEntries>
      <EarshotManifestText>{%0D%0A  "SchemaVersion": 1,%0D%0A  "Files": [%0D%0A$(EarshotManifestEntries)%0D%0A  ]%0D%0A}</EarshotManifestText>
    </PropertyGroup>
    <Error Condition="'@(EarshotHashedFile)' == ''" Text="Nothing was published, so no file manifest was written." />
    <WriteLinesToFile File="$(EarshotManifestPath)" Lines="$(EarshotManifestText)" Overwrite="true" WriteOnlyWhenDifferent="false" Encoding="UTF-8" />
    <Message Importance="high" Text="Earshot: wrote $(EarshotManifestPath) for @(EarshotHashedFile->Count()) published files." />
  </Target>
</Project>
